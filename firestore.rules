rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // User namespace — each user owns their data
    // Team members invited by the owner also get full access
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && (
        request.auth.uid == uid ||
        (
          request.auth.token.email != null &&
          exists(/databases/$(database)/documents/invites/$(request.auth.token.email.replace('.', '_').replace('@', '_'))) &&
          get(/databases/$(database)/documents/invites/$(request.auth.token.email.replace('.', '_').replace('@', '_'))).data.ownerUid == uid
        )
      );
    }

    // User profile doc at top level
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Invite records — any authenticated user can read/write
    match /invites/{encodedEmail} {
      allow read, write: if request.auth != null;
    }

    // Confirmation tokens — public read (crew members click without logging in)
    // Only authenticated users (production owners) can create them
    match /confirm_tokens/{token} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
