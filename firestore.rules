rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Same encoding the app uses: email.replace(/[.@]/g, '_'), lowercased
    function encodedEmail() {
      return request.auth.token.email.lower().replace('[.@]', '_');
    }

    function isInvitedTo(uid) {
      return signedIn()
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/invites/$(encodedEmail()))
        && get(/databases/$(database)/documents/invites/$(encodedEmail())).data.ownerUid == uid;
    }

    // ── Workspace data (subcollections only; the profile doc is matched below) ──
    // Owner has full access; team members invited by the owner too.
    match /users/{uid}/{collection}/{document=**} {
      allow read, write: if signedIn() && (request.auth.uid == uid || isInvitedTo(uid));
    }

    // Crew members respond to a confirmation link without an account.
    // The path is only reachable via an unguessable token; the update may
    // touch nothing but the confirmation fields.
    match /users/{uid}/productions/{productionId}/crew/{assignId} {
      allow update: if request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['confirmation_status', 'responded_at'])
        && request.resource.data.confirmation_status in ['confirmed', 'declined'];
    }

    // ── User profile ──
    // Owner may read and edit it, but plan/billing fields only change via the
    // server (the PayPal webhook uses the Admin SDK, which bypasses rules).
    match /users/{uid} {
      allow read: if signedIn() && request.auth.uid == uid;
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('plan', 'free') == 'free'
        && !('paypalSubscriptionId' in request.resource.data)
        && !('paypalPlanId' in request.resource.data)
        && !('planStatus' in request.resource.data)
        && !('planActivatedAt' in request.resource.data)
        && !('event_pass_until' in request.resource.data)
        && !('event_pass_order' in request.resource.data)
        && !('referralWindowStart' in request.resource.data);
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.get('plan', 'free') == resource.data.get('plan', 'free')
        && request.resource.data.get('planStatus', '') == resource.data.get('planStatus', '')
        && request.resource.data.get('paypalSubscriptionId', '') == resource.data.get('paypalSubscriptionId', '')
        && request.resource.data.get('event_pass_until', '') == resource.data.get('event_pass_until', '')
        && request.resource.data.get('event_pass_order', '') == resource.data.get('event_pass_order', '')
        && request.resource.data.get('paypalPlanId', '') == resource.data.get('paypalPlanId', '')
        && request.resource.data.get('referralWindowStart', '') == resource.data.get('referralWindowStart', '')
        && request.resource.data.get('referredBy', '') == resource.data.get('referredBy', '');
    }

    // ── Invites ──
    // Only the workspace owner can create/delete invites (and only with their
    // own uid). The invited user can read their invite and mark it accepted.
    match /invites/{encoded} {
      allow read: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        (request.auth.token.email != null && encoded == encodedEmail())
      );
      allow create: if signedIn() && request.resource.data.ownerUid == request.auth.uid;
      allow delete: if signedIn() && resource.data.ownerUid == request.auth.uid;
      allow update: if signedIn() && (
        resource.data.ownerUid == request.auth.uid ||
        (
          request.auth.token.email != null
          && encoded == encodedEmail()
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['accepted'])
        )
      );
    }

    // ── Confirmation tokens ──
    // Public read (crew click the link without logging in). Owner manages them;
    // anonymous visitors may only record their confirmation response.
    match /confirm_tokens/{token} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if
        (signedIn() && resource.data.uid == request.auth.uid) ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['snapshot', 'responded_at'])
          // inside the snapshot map, an anonymous responder may flip ONLY the
          // confirmation status — never rewrite the call-sheet copy itself
          && request.resource.data.snapshot.diff(resource.data.snapshot)
            .affectedKeys().hasOnly(['confirmation_status'])
          && request.resource.data.snapshot.confirmation_status in ['confirmed', 'declined']
        );
    }

    // ── Affiliate program ──
    // A signed-in user claims a code once; commissions are written only by
    // the server (Admin SDK). Referral records are created by the referred
    // user at signup, keyed by their own uid.
    match /affiliates/{code} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;

      match /referrals/{ruid} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/affiliates/$(code)).data.uid == request.auth.uid;
        allow create: if signedIn() && ruid == request.auth.uid
          && request.resource.data.uid == request.auth.uid;
      }

      match /commissions/{txn} {
        allow read: if signedIn()
          && get(/databases/$(database)/documents/affiliates/$(code)).data.uid == request.auth.uid;
      }
    }

    // ── Proposal tokens ──
    // Clients open a proposal link without an account. Public read; the owner
    // manages them; an anonymous client may only record accept/decline.
    match /proposal_tokens/{token} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
      allow update: if
        (signedIn() && resource.data.uid == request.auth.uid) ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['response', 'responded_at', 'response_note'])
          && request.resource.data.response in ['accepted', 'declined']
        );
    }

    // ── Live graphics control docs ──
    // The output overlay (OBS browser source, no login) reads the operator's
    // cues; only the owner writes them.
    match /live_graphics/{token} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // ── Shared call sheets ──
    // Public read so crew can view without login; only the owner writes them.
    match /shared_callsheets/{token} {
      allow read: if true;
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
